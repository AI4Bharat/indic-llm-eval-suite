# Everything Vertex-related lives here, not in the benchmark configs -- these are
# properties of your machine and your GCP account, not of a benchmark, so configs
# stay committable and shareable.

# --- Vertex AI (service account only; no API keys anywhere in this pipeline) ---
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json   # unset = use ADC
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1

# Bucket for batch prediction input/output (required for inference mode "batch";
# parallel mode needs no bucket). Must be in a region compatible with
# GOOGLE_CLOUD_LOCATION. The service account needs roles/storage.objectAdmin on
# the bucket and roles/aiplatform.user on the project.
GCS_BUCKET=your-batch-bucket
GCS_PREFIX=batch_trans

# --- Pushing the assembled dataset to the Hub ---
HF_TOKEN=

# Optional: shared dataset cache
# HF_HOME=/path/to/hf
# HF_HUB_CACHE=/path/to/hf/hub
